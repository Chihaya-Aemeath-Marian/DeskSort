<Window x:Class="DeskSort.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource AppTitle}" Width="900" Height="74" MinWidth="520" MinHeight="74" MaxHeight="74" WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False" AllowsTransparency="True" Background="Transparent" FontFamily="Yu Gothic UI" Loaded="Window_Loaded" StateChanged="Window_StateChanged" Closing="Window_Closing" Closed="Window_Closed">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#EB13C0"/><SolidColorBrush x:Key="PanelBrush" Color="#D8ECEBE4"/><SolidColorBrush x:Key="HeaderBrush" Color="#E8FEFDFA"/><SolidColorBrush x:Key="FileCardBrush" Color="#F5FEFDFA"/><SolidColorBrush x:Key="MutedBrush" Color="#858A80"/>
    <Style x:Key="HeaderButtonStyle" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#20EB13C0"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#38EB13C0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="FileTemplate">
      <Border Background="{StaticResource FileCardBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,0,7,7" Width="183" Tag="{Binding FullPath}" MouseMove="File_MouseMove" MouseRightButtonUp="File_RightClick" AllowDrop="True" Drop="File_Drop" DragOver="File_DragOver" ToolTip="{DynamicResource FileIconTooltip}">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSearchMatch}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="27" Height="30" CornerRadius="7" Background="{Binding TileBrush}" VerticalAlignment="Center" ClipToBounds="True"><Grid><TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{Binding GlyphBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DisplayIcon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding DisplayIcon}" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding IconScale}" ScaleY="{Binding IconScale}"/><TranslateTransform X="{Binding IconOffsetX}" Y="{Binding IconOffsetY}"/></TransformGroup></Image.RenderTransform><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DisplayIcon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid></Border><StackPanel Grid.Column="1" Margin="8,0,3,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/><TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="↗" FontSize="11" Padding="3,1" VerticalAlignment="Center" ToolTip="{DynamicResource OpenFile}" Click="OpenFile_Click" Tag="{Binding FullPath}"/></Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CategoryTemplate">
      <Border Width="{Binding PanelWidth}" Height="{Binding CategoryPanelHeight}" MinHeight="0" Background="{Binding PanelBackgroundBrush}" BorderBrush="#AFFFFFFF" BorderThickness="1" CornerRadius="18" Margin="0,0,0,17" Padding="13" VerticalAlignment="Top" AllowDrop="True" Drop="Category_Drop" DragOver="Category_DragOver" Tag="{Binding Id}" SizeChanged="CategoryPanel_SizeChanged">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12"/></Border.Effect><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Padding="8,3,8,3" Background="#E8FFFFFF" BorderBrush="#72FFFFFF" BorderThickness="1" CornerRadius="24" SizeChanged="CategoryHeader_SizeChanged">
            <Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="2,0,2,0"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Margin" Value="2,0,2,9"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid Height="42"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/><ColumnDefinition Width="30"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Width="29" Height="29"><TextBlock Text="{Binding Icon}" Foreground="{Binding DotBrush}" FontSize="17" TextAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IconImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding IconImage}" Stretch="UniformToFill" Cursor="Hand" MouseLeftButtonDown="CategoryPicture_Click" ToolTip="{DynamicResource CategoryImageTooltip}"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IconImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid>
              <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="SemiBold" Foreground="#17151A" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="4,3" LostFocus="CategoryName_LostFocus" ToolTip="{DynamicResource EditName}"/>
              <TextBlock Grid.Column="2" Text="{Binding Items.Count}" FontSize="11" Foreground="#514A50" VerticalAlignment="Center" Margin="6,0"/>
              <Button Grid.Column="3" Width="28" Height="28" Padding="0" FontSize="15" Foreground="#37313A" FocusVisualStyle="{x:Null}" Click="CategoryToggle_Click" Tag="{Binding Id}" ToolTip="{DynamicResource ToggleCategory}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}"><Setter Property="Content" Value="⌄"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="False"><Setter Property="Content" Value="›"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <TextBlock Grid.Column="4" Text="⠿" FontSize="15" Foreground="#77727A" Padding="5,1" VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="SizeAll" ToolTip="{DynamicResource MoveCategory}" PreviewMouseLeftButtonDown="CategoryMove_Start"/>
              <Button Grid.Column="5" Content="···" Width="28" Height="28" Padding="0" FontSize="14" Foreground="#5A5660" FocusVisualStyle="{x:Null}" Style="{StaticResource HeaderButtonStyle}" Click="CategoryMenu_Click" Tag="{Binding Id}" ToolTip="{DynamicResource CategorySettings}"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" MaxHeight="{Binding ItemsMaxHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource FileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style></ItemsControl><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style></ScrollViewer>
          <Grid Grid.Row="2" Margin="3,4,0,0"><TextBlock Text="{DynamicResource EmptyHint}" FontSize="9" Foreground="#70776C" VerticalAlignment="Center" Margin="0,0,28,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ShowEmptyHint}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Thumb Width="26" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeNWSE" Background="Transparent" Tag="{Binding Id}" DragDelta="CategoryResize_DragDelta" ToolTip="{DynamicResource ResizeCategory}"><Thumb.Style><Style TargetType="Thumb"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Thumb.Style><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ResizeSurface" Background="{TemplateBinding Background}" CornerRadius="6"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ResizeSurface" Property="Background" Value="#24EB13C0"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ResizeSurface" Property="Background" Value="#38EB13C0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb><TextBlock Text="↘" FontSize="14" Foreground="#807880" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="6" Background="#01000001">
    <Border Background="{StaticResource HeaderBrush}" BorderBrush="#88FFFFFF" BorderThickness="1" CornerRadius="15" Padding="11,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentBrush}"><TextBlock Text="▦" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Width="112" Margin="8,0,0,0"><TextBlock Text="{DynamicResource AppTitle}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="Subtitle" Text="{DynamicResource Subtitle}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="8" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="FileCount" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>
        <TextBox Grid.Column="1" x:Name="SearchBox" Width="160" HorizontalAlignment="Right" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="{DynamicResource SearchDesktop}" TextChanged="Search_TextChanged"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="AudioVisualizerButton" Content="♫" Width="34" Height="34" Margin="0,0,3,0" Style="{StaticResource HeaderButtonStyle}" ToolTip="{DynamicResource AudioStart}" Click="AudioVisualizerButton_Click"/><Button x:Name="LanguageButton" Content="文/A" Width="48" Height="34" Margin="0,0,3,0" Style="{StaticResource HeaderButtonStyle}" ToolTip="{DynamicResource Language}" Click="LanguageButton_Click"/><Button x:Name="ProfilesButton" Content="◇" Width="34" Height="34" Margin="0,0,3,0" Style="{StaticResource HeaderButtonStyle}" ToolTip="{DynamicResource Profiles}" Click="ProfilesButton_Click"/><Button Content="{DynamicResource AddCategory}" Width="68" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Padding="7,7" Click="AddCategory_Click"/><CheckBox x:Name="AutoStartCheck" Content="{DynamicResource AutoStart}" VerticalAlignment="Center" Margin="7,0,3,0" Click="AutoStart_Click"/><Button Content="↻" Width="36" Margin="2,0,0,0" ToolTip="{DynamicResource Refresh}" Click="Refresh_Click"/><Button Content="{DynamicResource ShowAll}" Width="78" Margin="2,0,0,0" Click="ShowHidden_Click"/><Button Content="×" Width="32" FontSize="17" Padding="4,0" Margin="2,0,0,0" ToolTip="{DynamicResource HideDesktopMenu}" Click="Close_Click"/></StackPanel>
      </Grid>
    </Border>
    <ItemsControl x:Name="CategoryBoard" Visibility="Collapsed"/><TextBlock x:Name="StorageText" Visibility="Collapsed"/>
  </Grid>
</Window>
