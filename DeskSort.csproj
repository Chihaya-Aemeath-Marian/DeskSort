<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>2.0.1</Version>
    <AssemblyName>デスク整理</AssemblyName>
    <RootNamespace>DeskSort</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\DeskSort.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="assets\SakuraFrame.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\DefaultBackgrounds\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
